type Query {
    transactions: [Transaction!]!
    transactionById(id: ID!): Transaction
    transactionsByAccount(accountId: ID!): [Transaction!]!
}

type Mutation {
    createTransaction(input: TransactionInput!): Transaction!
    transfer(input: TransferInput!): Transfer!
}

type Transaction {
    id: ID!
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String
    country: String
    type: TransactionType!
    createdAt: String!
}

type Transfer {
    debit: Transaction!
    credit: Transaction!
}

enum TransactionType {
    DEBIT
    CREDIT
}

input TransactionInput {
    accountId: ID!
    amount: Float!
    currency: String!
    merchantCategory: String!
    country: String!
}

input TransferInput {
    fromAccountId: ID!
    toAccountId: ID!
    amount: Float!
    currency: String!
}
