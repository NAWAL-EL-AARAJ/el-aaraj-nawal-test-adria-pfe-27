@startuml class-diagram
title Diagramme de classes

skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam roundCorner 10
skinparam nodesep 40
skinparam ranksep 50
skinparam ArrowColor #555555
skinparam ArrowFontSize 11
skinparam class {
  BorderColor #555555
  HeaderBackgroundColor #FFFFFF
}
skinparam class<<web>> {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}
skinparam class<<service>> {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
}
skinparam class<<repository>> {
  BackgroundColor #FFF8E1
  BorderColor #F9A825
}
skinparam class<<entity>> {
  BackgroundColor #FFEBEE
  BorderColor #C62828
}
skinparam class<<dto>> {
  BackgroundColor #F5F5F5
  BorderColor #9E9E9E
}
skinparam class<<feign>> {
  BackgroundColor #F3E5F5
  BorderColor #6A1B9A
}
skinparam class<<event>> {
  BackgroundColor #FFF3E0
  BorderColor #E65100
}
hide empty members
hide circle
hide stereotype

' =====================================================
package "account-service" {

  class AccountRestController <<web>>
  class AccountGraphQLController <<web>>
  class AccountMcpTools <<web>>

  class AccountService <<service>> {
    + create(AccountRequestDTO) : AccountResponseDTO
    + findById(UUID) : AccountResponseDTO
    + findAll() : List<AccountResponseDTO>
    + block(UUID) / activate(UUID)
  }

  class AccountRepository <<repository>>

  class Account <<entity>> {
    id : UUID
    customerReference : String
    status : AccountStatus
    currency : String
    balance : double
  }

  enum AccountStatus <<entity>> {
    ACTIVE
    BLOCKED
  }

  class AccountRequestDTO <<dto>> {
    customerReference : String
    currency : String
    balance : double
  }
  class AccountResponseDTO <<dto>> {
    id : UUID
    customerReference : String
    status : AccountStatus
    currency : String
    balance : double
  }

  AccountRestController -down-> AccountService
  AccountGraphQLController -down-> AccountService
  AccountMcpTools -down-> AccountService
  AccountService -down-> AccountRepository
  AccountRepository -down-> Account
  Account -right-> AccountStatus

  AccountService .right.> AccountRequestDTO
  AccountService .right.> AccountResponseDTO
  AccountRequestDTO -[hidden]down- AccountResponseDTO
}

' =====================================================
package "transaction-service" {

  class TransactionRestController <<web>>
  class TransactionGraphQLController <<web>>
  class TransactionMcpTools <<web>>

  class TransactionService <<service>> {
    + create(TransactionRequestDTO) : TransactionResponseDTO
    + findById(UUID) : TransactionResponseDTO
    + findByAccount(UUID) : List<TransactionResponseDTO>
  }

  class TransactionRepository <<repository>>

  class Transaction <<entity>> {
    id : UUID
    accountId : UUID
    amount : BigDecimal
    currency : String
    merchantCategory : String
    country : String
    createdAt : Instant
  }

  class AccountRestClient <<feign>> {
    + getAccount(UUID) : AccountDTO
  }

  class TransactionCreatedEvent <<event>> {
    transactionId : UUID
    accountId : UUID
    amount : BigDecimal
    currency : String
    merchantCategory : String
    country : String
    createdAt : Instant
  }

  class TransactionRequestDTO <<dto>> {
    accountId : UUID
    amount : BigDecimal
    currency : String
    merchantCategory : String
    country : String
  }
  class TransactionResponseDTO <<dto>> {
    id : UUID
    accountId : UUID
    amount : BigDecimal
    currency : String
    createdAt : Instant
  }
  class AccountDTO <<dto>> {
    id : UUID
    status : String
    balance : double
  }

  TransactionRestController -down-> TransactionService
  TransactionGraphQLController -down-> TransactionService
  TransactionMcpTools -down-> TransactionService
  TransactionService -down-> TransactionRepository
  TransactionRepository -down-> Transaction

  TransactionService .right.> TransactionRequestDTO
  TransactionService .right.> TransactionResponseDTO
  TransactionRequestDTO -[hidden]down- TransactionResponseDTO

  TransactionService -left-> AccountRestClient : Feign\n+ Resilience4J
  AccountRestClient .down.> AccountDTO
  TransactionService -down-> TransactionCreatedEvent : publie\n(Kafka)
}

' =====================================================
package "notification-service" {
  class TransactionEventListener <<service>>
}

TransactionEventListener .[norank].> TransactionCreatedEvent : consomme (Kafka)
AccountRestClient .[norank].> AccountRestController : HTTP

legend right
  |= Couleur |= Couche |
  |<#E3F2FD>| web (REST, GraphQL, MCP) |
  |<#E8F5E9>| service |
  |<#FFF8E1>| repository |
  |<#FFEBEE>| domain |
  |<#F5F5F5>| DTO |
  |<#F3E5F5>| client Feign |
  |<#FFF3E0>| événement Kafka |
endlegend
@enduml
