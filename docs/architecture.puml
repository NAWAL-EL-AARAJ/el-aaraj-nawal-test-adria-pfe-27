@startuml architecture
title Architecture micro-services

skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam defaultTextAlignment center
skinparam rectangleRoundCorner 12
skinparam packageStyle rectangle
skinparam nodesep 60
skinparam ranksep 70
skinparam ArrowColor #555555
skinparam ArrowFontSize 11
skinparam ArrowFontColor #333333

skinparam rectangle {
  BorderColor #555555
}
skinparam rectangle<<client>> {
  BackgroundColor #E3F2FD
  BorderColor #1565C0
}
skinparam rectangle<<infra>> {
  BackgroundColor #ECEFF1
  BorderColor #455A64
}
skinparam rectangle<<metier>> {
  BackgroundColor #E8F5E9
  BorderColor #2E7D32
}
skinparam rectangle<<ia>> {
  BackgroundColor #F3E5F5
  BorderColor #6A1B9A
}
skinparam queue {
  BackgroundColor #FFF3E0
  BorderColor #E65100
}
skinparam cloud {
  BackgroundColor #F3E5F5
  BorderColor #6A1B9A
}
hide stereotype

' ===== Clients =====
package "Clients" {
  rectangle "**Client Angular**" <<client>> as angular
  rectangle "**Client REST / Telegram**" <<client>> as telegram
}

' ===== Point d'entrée =====
rectangle "**gateway-service**\n:8080\nSpring Cloud Gateway" <<infra>> as gateway

' ===== Services métier =====
package "Services métier" {
  rectangle "**account-service**\n:8081\nREST · GraphQL · MCP" <<metier>> as account
  rectangle "**transaction-service**\n:8082\nREST · GraphQL · MCP" <<metier>> as transaction
}

' ===== Événements =====
queue "**Kafka**\nbank.transactions.created" as kafka
rectangle "**notification-service**\n:8083" <<metier>> as notification

' ===== IA =====
package "Intelligence artificielle" {
  rectangle "**ai-agent-service**\n:8084\nSpring AI · MCP Client" <<ia>> as agent
  cloud "**LLM**\nOpenAI" as llm
}

' ===== Infrastructure =====
package "Infrastructure (utilisée par tous les services)" {
  rectangle "**discovery-service**\n:8761\nEureka\n//annuaire des services//" <<infra>> as eureka
  rectangle "**config-service**\n:8888\nConfig Server\n//configuration centralisée//" <<infra>> as config
}

' ----- flux principal (haut -> bas) -----
angular -down-> gateway : HTTP
telegram -down-> gateway : HTTP
gateway -down-> account
gateway -down-> transaction
account <-right- transaction : Feign\n+ Resilience4J
transaction -down-> kafka : publie
kafka -right-> notification : consomme

' ----- IA (à droite) -----
telegram -right-> agent : chat
agent -right-> llm : prompt
agent -down-> transaction : MCP
agent -down-> account : MCP

' ----- placement -----
eureka -[hidden]right- config
kafka -[hidden]down- eureka
@enduml
